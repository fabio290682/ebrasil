# n8n environment - PRODUCTION
# Copie para .env no servidor de producao

# n8n core
N8N_HOST=n8n.seudominio.com
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.seudominio.com
WEBHOOK_URL=https://n8n.seudominio.com
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
N8N_LOG_LEVEL=info

# Security
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=trocar_senha_forte
N8N_SECURE_COOKIE=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# Encryption key (obrigatorio para credenciais)
N8N_ENCRYPTION_KEY=trocar_por_chave_longa_32_chars_min

# Banco do n8n (metadados de workflow)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres-interno
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=trocar_senha_forte
DB_POSTGRESDB_SCHEMA=public

# API keys para workflows
OPENAI_API_KEY=sk-xxxx
PORTAL_TRANSPARENCIA_API_KEY=xxxx

# Alertas
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/THIS/WEBHOOK

# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
