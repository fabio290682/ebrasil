# n8n environment - DEVELOPMENT
# Copie para .env no seu ambiente de dev

# n8n core
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true

# Security
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=trocar_essa_senha

# Encryption key (obrigatorio para credenciais)
N8N_ENCRYPTION_KEY=trocar_por_chave_longa_32_chars_min

# Banco do n8n (metadados de workflow)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=trocar_senha_n8n
DB_POSTGRESDB_SCHEMA=public

# API keys para workflows
OPENAI_API_KEY=sk-xxxx
PORTAL_TRANSPARENCIA_API_KEY=xxxx

# Alertas
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/THIS/WEBHOOK

# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
