{
  "projectSettings": {
    "nodeVersion": "20.x"
  },
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://seu-backend.onrender.com/api/:path*"
    }
  ]
}
